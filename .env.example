# OKX Demo Trading API credentials. Create these under OKX Demo Trading.
# Never commit the real values; copy this file to .env and fill it locally.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
# Keep 1 for demo trading; set to 0 only with a live API key.
OKX_SIMULATED_TRADING=1

# Optional: override the default data/okx_demo.sqlite3 location (uncomment for systemd).
# OKX_DEMO_DB=/opt/okx-quant/data/okx_demo.sqlite3
# Optional Clash HTTP mixed-port proxy for restricted networks.
# OKX_PROXY_URL=http://127.0.0.1:7890
